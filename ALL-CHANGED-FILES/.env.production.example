# ── Server ──────────────────────────────────────────────
PORT=3020
NODE_ENV=production

# ── MySQL ───────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=casino_platform
DB_USER=casino
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT (generate with: openssl rand -hex 32) ───────────
JWT_SECRET=CHANGE_ME_JWT_SECRET_64_HEX
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_64_HEX
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# ── Xendit (optional until payments live) ───────────────
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_TOKEN=

# ── App URLs ────────────────────────────────────────────
FRONTEND_URL=https://reelx.lazapee.ph
ADMIN_URL=https://reelx.lazapee.ph/admin
DOMAIN=reelx.lazapee.ph

# ── Frontend build (used by CI / update scripts) ────────
VITE_API_URL=https://reelx.lazapee.ph/api
VITE_SOCKET_URL=https://reelx.lazapee.ph

# ── Email (optional) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
